[Unit]
Description=TeleAntiSpam2Bot gophers_id admin-right check
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=teleantispam
Group=teleantispam
WorkingDirectory=/var/lib/teleantispam
EnvironmentFile=-/etc/teleantispam/teleantispam.env
ExecStart=/usr/local/bin/teleantispam -check-admin

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/teleantispam
CapabilityBoundingSet=
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
