[Unit]
Description=TeleAntiSpam2Bot Telegram moderation bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=teleantispam
Group=teleantispam
WorkingDirectory=/var/lib/teleantispam
EnvironmentFile=-/etc/teleantispam/teleantispam.env
ExecStart=/usr/local/bin/teleantispam
Restart=always
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/teleantispam
CapabilityBoundingSet=
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
